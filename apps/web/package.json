{
  "name": "@l2ce/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "create": "npx --yes @gromlab/template-file-generator@0.3.1 --skip-update",
    "generate:github": "pnpm dlx @gromlab/rest-api-codegen@5.2.4 --input src/infra/github-api/schema/contributors.openapi.json --output src/infra/github-api/generated",
    "browser": "pnpm -w browser",
    "dev": "next dev --webpack",
    "build": "next build --webpack && tsx scripts/finalize-export.ts && node scripts/check-export.mjs",
    "start": "pnpm preview",
    "preview": "tsx scripts/preview.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs",
    "lint": "eslint . && pnpm architecture:check",
    "test": "tsx --test test/*.test.ts test/*.test.mjs"
  },
  "dependencies": {
    "@l2ce/core": "workspace:*",
    "@l2ce/database": "workspace:*",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "@tabler/icons-react": "3.50.0",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "4.0.0",
    "@l2ce/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "8.5.32",
    "postcss-custom-media": "12.0.3",
    "postcss-nesting": "14.0.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "webpack": "^5.112.2"
  },
  "browserslist": [
    "Chrome >= 111",
    "Edge >= 111",
    "Firefox >= 128",
    "Safari >= 16.4"
  ]
}
