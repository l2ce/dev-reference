{
  "name": "@l2ce/dev-reference-mcp",
  "version": "0.1.0",
  "description": "MCP-доступ к базе знаний L2CE Dev Reference",
  "private": true,
  "type": "module",
  "bin": {
    "protocols-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/l2ce/dev-reference.git",
    "directory": "apps/mcp"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsx watch src/index.ts --data-dir ../../packages/database/data",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "pnpm --workspace-root exec turbo run build --filter=@l2ce/dev-reference-mcp"
  },
  "dependencies": {
    "@l2ce/core": "workspace:*",
    "@l2ce/database": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@l2ce/typescript-config": "workspace:*",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
